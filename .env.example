# ==============================================================================
# QUÉ HAY PA' HACER — Variables de Entorno para Docker Compose & Producción (EC2)
# ==============================================================================
# Copia este archivo a .env antes de levantar los contenedores:
# cp .env.example .env

# --- Base de Datos MySQL ---
DB_NAME=quehaypahacer
DB_ROOT_PASSWORD=pepe
DB_USER=quehaypahacer_user
DB_PASSWORD=pepe
DB_PORT=3306

# --- Microsoft Entra ID (Azure AD) ---
# Credenciales públicas configuradas en el tenant propio "QueHayPaHacer"
AZURE_TENANT_ID=1abed6ed-c70a-4381-b9fe-0a67d2f0745e
AZURE_CLIENT_ID=36bb5da3-29f4-4386-988b-244a844b285c

# --- Seguridad y CORS ---
# Orígenes permitidos separados por coma (desarrollo local, IP de EC2, API Gateway o Dominio)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1

# --- Frontend Build Args ---
# En desarrollo: http://localhost:8080/api
# En producción con EC2/API Gateway: http://<IP_PUBLICA_EC2>:8080/api o https://<API_GATEWAY_ID>.execute-api.us-east-1.amazonaws.com/api
VITE_API_URL=http://localhost:8080/api
VITE_REDIRECT_URI=http://localhost:5173
