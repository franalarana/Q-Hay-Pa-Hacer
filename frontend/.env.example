# ==============================================================================
# FRONTEND (React + Vite) — Variables de Entorno
# ==============================================================================
# Copia este archivo a frontend/.env para desarrollo local:
# cp .env.example .env

# URL base del Backend Spring Boot o AWS API Gateway
VITE_API_URL=http://localhost:8080/api

# Configuración Microsoft Entra ID (Tenant propio QueHayPaHacer)
VITE_AZURE_CLIENT_ID=36bb5da3-29f4-4386-988b-244a844b285c
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/1abed6ed-c70a-4381-b9fe-0a67d2f0745e

# Redirect URI registrada en la App Registration de Azure
# En local: http://localhost:5173
# En producción EC2: http://<IP_PUBLICA_EC2> o https://tudominio.cl
VITE_REDIRECT_URI=http://localhost:5173
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
