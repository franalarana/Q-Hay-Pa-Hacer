                "api",
                "despensa"
              ]
            },
            "description": "Agrega o actualiza ingrediente en despensa y publica NotificacionDespensaEvent (AGREGADO o ACTUALIZADO)."
          },
          "response": []
        },
        {
          "name": "3. Test DLQ - Ticket Válido (ACK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/ticket-valido",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "ticket-valido"
              ]
            },
            "description": "Publica TicketCocinaEvent válido (recetaId = 1). Espera 202 Accepted. Consumidor confirma con ACK."
          },
          "response": []
        },
        {
          "name": "4. Test DLQ - Ticket Inválido (NACK -> DLQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/ticket-invalido",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "ticket-invalido"
              ]
            },
            "description": "Publica TicketCocinaEvent con recetaId = -1. Espera 202 Accepted. Consumidor hace NACK (requeue=false) y cae en recetas.tickets.dlq."
          },
          "response": []
        },
        {
          "name": "5. Test DLQ - Notificación Inválida (NACK -> DLQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/notificacion-invalida",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "notificacion-invalida"
              ]
            },
            "description": "Publica NotificacionDespensaEvent con accion = null. Espera 202 Accepted. Consumidor hace NACK y cae en recetas.notificaciones.dlq."
          },
          "response": []
        },
        {
          "name": "6. Test DLQ - Favorito Inválido (NACK -> DLQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/favorito-invalido",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "favorito-invalido"
              ]
            },
            "description": "Publica FavoritoEvent con recetaId = -1. Espera 202 Accepted. Consumidor hace NACK y cae en la 3ra DLQ: recetas.favoritos.dlq."
          },
          "response": []
        }
      ]
