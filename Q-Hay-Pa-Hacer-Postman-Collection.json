{
  "info": {
    "name": "Q-Hay-Pa-Hacer API Tests",
    "description": "Evidencia de pruebas de endpoints protegidos por JWT y Roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Obtener Mis Recetas (SIN Token - Espera 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/recetas/mis-recetas",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "recetas",
            "mis-recetas"
          ]
        },
        "description": "Debe fallar con estado 401 Unauthorized por falta de Bearer token."
      },
      "response": []
    },
    {
      "name": "2. Obtener Mis Recetas (CON Token - Espera 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer TU_TOKEN_JWT_AQUI",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/recetas/mis-recetas",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "recetas",
            "mis-recetas"
          ]
        },
        "description": "Debe retornar 200 OK asumiendo que se reemplace TU_TOKEN_JWT_AQUI por un token válido del frontend."
      },
      "response": []
    },
    {
      "name": "3. Eliminar Receta (Sin Rol Admin - Espera 403)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer TU_TOKEN_JWT_AQUI",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/recetas/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "recetas",
            "1"
          ]
        },
        "description": "Debe fallar con estado 403 Forbidden asumiendo un token válido pero de un usuario sin el rol Admin."
      },
      "response": []
    },
    {
      "name": "RabbitMQ - Eventos y DLQ",
      "item": [
        {
          "name": "1. Registrar Cocinado (Publica TicketCocinaEvent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notas\": \"Prueba de cocinado para publicar en RabbitMQ\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/historial/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "historial",
                "1"
              ]
            },
            "description": "Registra cocinado de receta 1 y tras commit en BD publica TicketCocinaEvent en recetas.tickets.queue."
          },
          "response": []
        },
        {
          "name": "2. Agregar a Despensa (Publica NotificacionDespensaEvent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredienteId\": 1,\n  \"cantidad\": 2.0,\n  \"unidad\": \"KILOGRAMO\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/despensa",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "despensa"
              ]
            },
            "description": "Agrega o actualiza ingrediente en despensa y publica NotificacionDespensaEvent (AGREGADO o ACTUALIZADO)."
          },
          "response": []
        },
        {
          "name": "3. Test DLQ - Ticket Válido (ACK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/ticket-valido",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "ticket-valido"
              ]
            },
            "description": "Publica TicketCocinaEvent válido (recetaId = 1). Espera 202 Accepted. Consumidor confirma con ACK."
          },
          "response": []
        },
        {
          "name": "4. Test DLQ - Ticket Inválido (NACK -> DLQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/ticket-invalido",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "ticket-invalido"
              ]
            },
            "description": "Publica TicketCocinaEvent con recetaId = -1. Espera 202 Accepted. Consumidor hace NACK (requeue=false) y cae en recetas.tickets.dlq."
          },
          "response": []
        },
        {
          "name": "5. Test DLQ - Notificación Inválida (NACK -> DLQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/rabbitmq/test/notificacion-invalida",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "admin",
                "rabbitmq",
                "test",
                "notificacion-invalida"
              ]
            },
            "description": "Publica NotificacionDespensaEvent con accion = null. Espera 202 Accepted. Consumidor hace NACK y cae en recetas.notificaciones.dlq."
          },
          "response": []
        }
      ]
    }
  ]
}
